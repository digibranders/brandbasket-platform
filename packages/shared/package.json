    "libphonenumber-js": "1.13.13",
    "pdf-lib": "1.17.1",
    "server-only": "0.0.1",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "vitest": "^5.0.0"
