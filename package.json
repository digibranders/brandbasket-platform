{
  "name": "brandbasket-platform",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @brandbasket/platform --filter @brandbasket/admin dev",
    "dev:platform": "pnpm --filter @brandbasket/platform dev",
    "dev:admin": "pnpm --filter @brandbasket/admin dev",
    "dev:tunnel": "bash scripts/dev-webhook-tunnel.sh",
    "build": "pnpm --filter @brandbasket/platform --filter @brandbasket/admin build",
    "lint": "pnpm --filter @brandbasket/platform --filter @brandbasket/admin lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm db:migrate:test && pnpm -r --workspace-concurrency=1 test:integration",
    "env:init": "pnpm --filter @brandbasket/db env:init",
    "db:roles": "pnpm --filter @brandbasket/db db:roles",
    "db:migrate": "pnpm --filter @brandbasket/db db:migrate",
    "db:migrate:test": "pnpm --filter @brandbasket/db db:migrate:test",
    "directory:import-places": "pnpm --filter @brandbasket/db directory:import-places",
    "directory:import-pincodes": "pnpm --filter @brandbasket/db directory:import-pincodes",
    "directory:backfill-places": "pnpm --filter @brandbasket/db directory:backfill-places",
    "pictures:backfill-copies": "pnpm --filter @brandbasket/db exec tsx --tsconfig ../../apps/platform/tsconfig.json ../../apps/platform/scripts/backfill-picture-copies.ts",
    "directory:import-listings": "pnpm --filter @brandbasket/db directory:import-listings",
    "cms:migrate": "pnpm --filter @brandbasket/platform cms:migrate",
    "cms:migrate:create": "node scripts/cms-create-migration.mjs",
    "cms:migrate:status": "pnpm --filter @brandbasket/platform cms:migrate:status",
    "env:check": "pnpm --filter @brandbasket/db exec tsx ../../scripts/server/check-env.ts",
    "staff:create": "pnpm --filter @brandbasket/auth staff:create",
    "retention:run": "pnpm --filter @brandbasket/db exec tsx ../../apps/platform/scripts/retention-run.ts",
    "support:attachments:maintain": "pnpm --filter @brandbasket/db exec tsx --conditions=react-server ../../apps/platform/scripts/maintain-support-attachments.ts"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.29.1",
      "dompurify": "^3.4.17",
      "source-map-js": "^1.2.2",
      "esbuild@<0.25.0": "0.25.12"
    }
  }
}
