# Fynix production environment for apps/admin (the staff console at staff.fynix.digital).
#
# A single-brand server: PLATFORM_BRAND=fynix dresses the console as Fynix's (name, logo, sign-in text), hides the sections
# that belong to Firstfold's directory, and sends staff-sent mail as Fynix Digital. Values belong in .env.production on
# the server, never in this file. The platform's list is apps/platform/.env.production.example; the SAME values must be
# used here for everything the two apps share (marked "same as the platform"). Generate secrets with `openssl rand -hex 32`.
# PLATFORM_BRAND is read at build time as well as at start.

# =====================================================================================================================
# REQUIRED TO START (checked at boot, apps/admin/instrumentation.ts, when ADMIN_ORIGIN or APP_ORIGIN is a public https host)
# =====================================================================================================================
PLATFORM_BRAND=fynix

# This console's own https URL, and the customer dashboard's: https://staff.fynix.digital and https://app.fynix.digital.
# Two separate hosts: each app sets a host-only session cookie, never one shared across fynix.digital (docs/STAFF-ACCESS.md).
# Setup links staff send point at APP_ORIGIN. Same two values in the platform's environment.
ADMIN_ORIGIN=https://staff.fynix.digital
APP_ORIGIN=https://app.fynix.digital

# The staff database role, and the Payload database. Same as the platform. The console never gets the customer role's URL.
DATABASE_URL_STAFF=
DATABASE_URL_PAYLOAD=

# At least 32 characters each. Same as the platform: a session signed by one is read by the other's checks.
BETTER_AUTH_SECRET=
PAYLOAD_SECRET=

# Brevo transactional email, for mail staff send to customers (setup links, "preview ready", "website live"). Same key as the platform.
BREVO_API_KEY=

# =====================================================================================================================
# REQUIRED TO TAKE OR PRICE PAYMENTS (checked the first time the console talks to the provider)
# =====================================================================================================================
# Same value and keys as the platform: the Pricing page creates the provider's plans.
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =====================================================================================================================
# OPTIONAL
# =====================================================================================================================
# Same as the platform: sender, alert inboxes, invoice series and the media and support storage the two apps share.
FYNIX_MAIL_FROM=
SUPPORT_ALERT_EMAIL=
INVOICE_PREFIX=
FIRSTFOLD_MEDIA_ROOT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
FIRSTFOLD_SUPPORT_ROOT=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
NEXT_PUBLIC_FIRSTFOLD_RELEASE=

# Never set on a real deployment: any OTP bypass switch, FIRSTFOLD_ALLOW_FAKE_BILLING. Leave Firstfold's directory settings
# (DIRECTORY_URL_KEY, GEO_CATALOG_SOURCE, VIMEO_ACCESS_TOKEN) unset: the console's directory sections are switched off for Fynix.
