# Brandbasket production environment for apps/admin (the staff console at console.brandbasket.in).
#
# The console is dressed as Brandbasket's (name, logo, sign-in text), hides the sections that belong to the directory, and sends
# staff-sent mail as Brandbasket. Values belong in .env.production on
# the server, never in this file. The platform's list is apps/platform/.env.production.example; the SAME values must be
# used here for everything the two apps share (marked "same as the platform"). Generate secrets with `openssl rand -hex 32`.

# =====================================================================================================================
# REQUIRED TO START (checked at boot, apps/admin/instrumentation.ts, when ADMIN_ORIGIN or APP_ORIGIN is a public https host)
# =====================================================================================================================

# This console's own https URL, and the customer dashboard's: https://console.brandbasket.in and https://app.brandbasket.in.
# Two separate hosts: each app sets a host-only session cookie, never one shared across brandbasket.in (docs/STAFF-ACCESS.md).
# Setup links staff send point at APP_ORIGIN. Same two values in the platform's environment.
ADMIN_ORIGIN=https://console.brandbasket.in
APP_ORIGIN=https://app.brandbasket.in

# The staff database role, and the Payload database. Same as the platform. The console never gets the customer role's URL.
DATABASE_URL_STAFF=
DATABASE_URL_PAYLOAD=

# At least 32 characters each. Same as the platform: a session signed by one is read by the other's checks.
BETTER_AUTH_SECRET=
PAYLOAD_SECRET=

# Brevo transactional email, for mail staff send to customers (setup links, "preview ready", "website live"). Same key as the platform.
BREVO_API_KEY=

# =====================================================================================================================
# REQUIRED TO TAKE OR PRICE PAYMENTS (checked the first time the console talks to the provider)
# =====================================================================================================================
# Same value and keys as the platform: the Pricing page creates the provider's plans.
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =====================================================================================================================
# OPTIONAL
# =====================================================================================================================
# Same as the platform: sender, alert inboxes, invoice series and the media and support storage the two apps share.
BRANDBASKET_MAIL_FROM=
# The domain free website addresses are made on (<name>.<this domain>), the SAME as the platform's. Unset, staff cannot give a
# client a free address. Uncomment and set it, e.g. sites.example.com, to offer them (apps/platform/.env.production.example).
# CLIENT_SITE_BASE_DOMAIN=
SUPPORT_ALERT_EMAIL=
INVOICE_PREFIX=
BRANDBASKET_MEDIA_ROOT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BRANDBASKET_SUPPORT_ROOT=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
NEXT_PUBLIC_BRANDBASKET_RELEASE=

# Never set on a real deployment: the EMAIL_CODE_BYPASS switch, BRANDBASKET_ALLOW_FAKE_BILLING. Leave Brandbasket's directory settings
# (DIRECTORY_URL_KEY, GEO_CATALOG_SOURCE, VIMEO_ACCESS_TOKEN) unset: the console's directory sections are switched off for Brandbasket.

# The email of the Google service account (the one in apps/platform's GA4_SERVICE_ACCOUNT_JSON key file). The client's Website tab
# tells staff to ask the customer to add it as a Viewer on their Analytics property. Optional: unset, it says "our service account".
GA4_SERVICE_ACCOUNT_EMAIL=

# The Brandbasket Google account's sign-in (plan 62), used from Settings, Google account. The OAuth client is made in Google
# Cloud, Google Auth Platform, Clients (type Web application). The redirect must be one of the client's authorised redirect URIs:
# https://console.brandbasket.in/api/google/callback in production, http://localhost:3199/api/google/callback locally (Google does
# not accept .localhost hosts, so open the console at localhost:3199 for that one sign-in). Unset, Settings says it is not set up.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# The only account the console accepts a sign-in from.
GOOGLE_ACCOUNT_EMAIL=
# Keep equal to the platform's value: the Google card says whether the Analytics tag is on or switched off for client sites.
GOOGLE_ANALYTICS_TAG_ENABLED=

# Cloudflare Access protection for the staff console (see docs/STAFF-ACCESS.md).
# Set REQUIRE_CF_ACCESS=1 to verify the Cf-Access-Jwt-Assertion header on every request.
# When enabled, requests without a valid assertion signed by Cloudflare Access are refused with 401.
REQUIRE_CF_ACCESS=
CF_ACCESS_AUDIENCE=
CF_ACCESS_ISSUER=

