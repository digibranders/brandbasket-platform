# Staff Postgres role. Every admin read and write goes through this.
DATABASE_URL_STAFF=

# Payload's own database, read for the blog API token shown on a client page.
DATABASE_URL_PAYLOAD=
PAYLOAD_SECRET=

# Session signing. Must match the platform's value so staff sessions verify.
BETTER_AUTH_SECRET=

# This app's own absolute URL, e.g. http://admin.localhost:3003
ADMIN_ORIGIN=

# The customer app's URL. Setup links staff send point there, not here.
APP_ORIGIN=

# Inbox that receives lead and support notifications (e.g. support@brandbasket.in).
BRANDBASKET_TEAM_EMAIL=

# Private support screenshots, served to staff on support requests. Locally they live in BRANDBASKET_SUPPORT_ROOT (default
# .data/support-private); it must be the SAME absolute directory as the platform's, and sit outside BRANDBASKET_MEDIA_ROOT.
# For production, set ALL FOUR SUPPORT_R2_* values, the same four as the platform's, for a private bucket that is not
# R2_BUCKET; a partial set is refused, not ignored. See docs/operations/support-attachments.md.
# Deliberately absent: BREVO_API_KEY, ALERTS_FROM_* and SUPPORT_ALERT_EMAIL (only the platform sends alerts) and
# SUPPORT_TICKET_RETENTION_MONTHS (only the scheduled maintenance command reads it).
BRANDBASKET_SUPPORT_ROOT=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=

# Git commit hash (7 to 64 hex characters) of the deploy, set before the build. Tags the native automatic errors inbox
# (docs/operations/automatic-errors.md). Unset or invalid becomes "unknown". Use the same value as the platform.
NEXT_PUBLIC_BRANDBASKET_RELEASE=

# Payments: the SAME BILLING_PROVIDER, RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET as the platform's. The Pricing page
# creates the Razorpay plan for every new price, and staff actions cancel replaced checkouts there. Unset in development
# means the fake provider. See apps/platform/.env.example. The webhook secret is the platform's alone.
BILLING_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Exactly 1 lets the fake provider run on a private test deployment. Leave unset everywhere else.
BRANDBASKET_ALLOW_FAKE_BILLING=

# Deliberately absent: DATABASE_URL (the customer's row-level-security-bound connection) and
# DATABASE_URL_PUBLIC (insert-only, for the marketing lead form). The admin has no reason to hold either.

# Must be the SAME absolute directory as the platform's, or staff see broken images for every customer upload.
BRANDBASKET_MEDIA_ROOT=

# A Vimeo API access token (scopes private, upload, edit, delete), the SAME as the platform's: staff take-downs delete the
# video from Vimeo.
VIMEO_ACCESS_TOKEN=

# Optional: the SAME four as the platform's if it keeps pictures in a Cloudflare R2 bucket (see apps/platform/.env.example).
# Set all four or none.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Key for business URL codes, /in/mh/business/<name>/<code> (packages/db/src/place-id.ts). MUST equal the website's
# DIRECTORY_URL_KEY (32+ characters). Left empty, the website's interim key is used, as on the website: set both together,
# once, since changing it changes every business URL.
DIRECTORY_URL_KEY=

# Where the directory's areas, categories and opened districts come from: "file" (packages/shared places.json, the
# default) or "db" (the geo_* tables edited on the staff console's Geography page). Set it on BOTH apps; the database
# read falls back to the file lists while the tables are empty.
GEO_CATALOG_SOURCE=file

# Cloudflare Turnstile, the robot check on the sign-in, sign-up, password and setup forms. Both keys come from the widget in
# the Cloudflare dashboard (its domains: brandbasket.in, app.brandbasket.in, console.brandbasket.in). Unset, the check is off and
# the forms work as before. Set the same two on the website and on both apps. TURNSTILE_HOSTNAMES (comma separated) is
# optional: the hostnames a token may be solved on, defaulting to those three plus www.brandbasket.in.
# Development ignores the keys, because the real widget refuses localhost. To try the widget locally set
# TURNSTILE_ENABLE_IN_DEVELOPMENT=true with Cloudflare's test keys (1x00000000000000000000AA and
# 1x0000000000000000000000000000000AA).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
