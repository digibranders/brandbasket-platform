    "@brandbasket/shared": "workspace:*",
    "@lexical/link": "0.41.0",
    "@lexical/list": "0.41.0",
    "@lexical/react": "0.41.0",
    "@lexical/rich-text": "0.41.0",
    "@lexical/selection": "0.41.0",
    "@payloadcms/next": "^3.90.2",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/nextjs": "^11.6.0",
    "geist": "1.9.0",
