# Production environment for apps/customer (the customer app v4, port 3202).
#
# On the VPS this becomes /srv/brandbasket/shared/customer.env.production (brandbasket, mode 600). Each release links it to
# apps/customer/.env.production after the build, and `next start` reads it. NEVER put values in this file: copy it and fill the
# copy. Generate secrets with `openssl rand -hex 32`. The runbook is docs/deployment/brandbasket-vps.md, "Customer app v4".
#
# This app reads the same databases and the same upload folders as apps/platform, so most values are copies of the platform's file
# (/srv/brandbasket/shared/platform.env.local). "Same as platform" below means the value must be identical, not merely similar.
#
# NEXT_PUBLIC_* values are compiled into the browser code at BUILD time, so setting them here has no effect on the browser
# bundle. They come from deploy/vps/brandbasket-platform-build.env (NEXT_PUBLIC_GTM_ID is already there) or the GitHub runner's
# environment. The server also reads them, so the ones that matter are listed for completeness.
#
# The server refuses to start without APP_ORIGIN, DATABASE_URL, DATABASE_URL_STAFF and a BETTER_AUTH_SECRET of 32 characters or
# more (src/lib/env.ts, checked at boot in src/instrumentation.ts). On a deployment served over https it also ignores
# EMAIL_CODE_BYPASS and refuses the fake billing provider.

# =====================================================================================================================
# REQUIRED
# =====================================================================================================================

# This app's own public address, no path. Sessions are host-only cookies, so it is the host people sign in on.
#   staging (next.brandbasket.in)  https://next.brandbasket.in
#   after the cutover              https://app.brandbasket.in, the same value as platform's APP_ORIGIN
# Change it with the nginx cutover and restart the unit; Better Auth builds its base URL and trusted origins from it.
APP_ORIGIN=
# The staff console's address, https://console.brandbasket.in. Same as platform.
ADMIN_ORIGIN=

# PostgreSQL, the brandbasket_platform database, the same three roles as platform.
#   DATABASE_URL         bb_app: customer work, row-level security applies
#   DATABASE_URL_STAFF   bb_staff: system work (the exceptions documented in src/lib/db.ts)
#   DATABASE_URL_PUBLIC  bb_public: insert-only, sign-up codes and account email are written to the outbox through it
#                        (read on first use: a gap shows as a failed sign-up, not a failed start)
# DATABASE_URL_PAYLOAD and PAYLOAD_SECRET: the blog (Payload) database and secret, the same values as apps/platform.
DATABASE_URL=
DATABASE_URL_STAFF=
DATABASE_URL_PUBLIC=

# At least 32 characters. Must be EXACTLY platform's value, on staging too: at the cutover this is what keeps every customer
# signed in. Never set BETTER_AUTH_SECRETS (the server refuses to start with it).
BETTER_AUTH_SECRET=

# Hashes every 6-digit code emailed at sign-up (HMAC). At least 32 characters. Same as platform. BOOKING_OTP_SECRET is the older
# name for the same thing and is read only when this is unset.
ACCOUNT_CODE_SECRET=

# Brevo transactional email. Without it the codes are only written to the outbox and nobody receives them. Same as platform.
BREVO_API_KEY=

# The secret the marketing site shares with the app. It also seals the ad landing page's start token, so it must be platform's
# value or every ad link already sent stops prefilling. At least 32 characters; shorter or unset means no prefill.
LEADS_API_TOKEN=

# =====================================================================================================================
# PAYMENTS (read the first time a checkout opens)
# =====================================================================================================================

# "razorpay" on a real deployment. Unset on a real deployment makes checkout throw rather than hand out plans for free.
BILLING_PROVIDER=razorpay
# Same pair as platform.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A secret you choose; the same value is entered in Razorpay's dashboard webhook. Same as platform. The webhook (/api/webhooks/razorpay)
# is served by this app once nginx points it here; unset, the route refuses every request.
RAZORPAY_WEBHOOK_SECRET=

# =====================================================================================================================
# UPLOADS (the apps share them: same values as platform)
# =====================================================================================================================

# An absolute path outside the releases, /srv/brandbasket/media on the VPS. Unset, uploads go into the release and are lost at
# the next deploy. The unit may write /srv/brandbasket/media and /srv/brandbasket/support-private only.
BRANDBASKET_MEDIA_ROOT=
# Private support screenshots: a directory outside BRANDBASKET_MEDIA_ROOT, or all four SUPPORT_R2_* values. A partial set is refused.
BRANDBASKET_SUPPORT_ROOT=
# Object storage instead of the media folder, if platform uses it: all four, the same as platform.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=

# =====================================================================================================================
# OPTIONAL
# =====================================================================================================================

# Who customer mail comes from, "Brandbasket" <BRANDBASKET_MAIL_FROM>. Default no-reply@brandbasket.in. ALERTS_FROM_EMAIL and
# ALERTS_FROM_NAME are older names read when this is unset.
BRANDBASKET_MAIL_FROM=
ALERTS_FROM_EMAIL=
ALERTS_FROM_NAME=
# Inboxes for team notices. Security alerts go to SECURITY_ALERT_EMAIL, else SUPPORT_ALERT_EMAIL, else BRANDBASKET_TEAM_EMAIL,
# else the default support inbox. Replies to customers go to SUPPORT_ALERT_EMAIL when set.
SUPPORT_ALERT_EMAIL=
SECURITY_ALERT_EMAIL=
BRANDBASKET_TEAM_EMAIL=

# Tax invoice number prefix, 1 to 3 capital letters or digits. Same as platform: a different prefix starts a new series.
INVOICE_PREFIX=

# The domain temporary website addresses are made on, <business>.<this domain>. Unset means not offered.
CLIENT_SITE_BASE_DOMAIN=

# Support rollout. Unset or "on": everyone can send requests and feedback. "internal": only the account ids in
# BRANDBASKET_SUPPORT_INTERNAL_ACCOUNT_IDS (comma separated). Anything else: no one.
BRANDBASKET_SUPPORT_MODE=
BRANDBASKET_SUPPORT_INTERNAL_ACCOUNT_IDS=

# Kickoff and call booking. Cal.com is used when CALCOM_API_KEY is set and the booking link is a Cal.com page; Calendly when
# CALENDLY_API_TOKEN is set (a paid Calendly plan). Neither: the booking page itself is shown. Same as platform.
CALCOM_API_KEY=
CALENDLY_API_TOKEN=

# OyeChats API address (an origin such as https://api.oyechats.example, never a secret). Unset: Enquiries lists leads without
# message counts and cannot open a conversation.
OYECHATS_API_URL=

# The robot check on sign-in and sign-up (Cloudflare Turnstile). Off while either key is unset. TURNSTILE_HOSTNAMES (comma
# separated) lists the hosts tokens are accepted for; default the hosts of APP_ORIGIN and ADMIN_ORIGIN. The widget key is
# bound to hostnames in Cloudflare: add next.brandbasket.in to it for staging.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Error reporting, both off while unset. NEXT_PUBLIC_SENTRY_DSN is also needed at build time for the browser. SENTRY_AUTH_TOKEN is
# read only by `next build` (source map upload), so it belongs to the build, not to this file.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# A build identifier shown on error reports. Build time.
NEXT_PUBLIC_BRANDBASKET_RELEASE=

# Where customers sign in, in links and emails (shared site config). Build time; the build env sets it to https://app.brandbasket.in,
# which is right on staging as well, so leave it alone.
NEXT_PUBLIC_APP_URL=
# Marketing site and contact details used in links. Defaults: https://brandbasket.in and support@brandbasket.in. Build time.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CALENDLY_URL=

# =====================================================================================================================
# PUBLIC API AND JOBS (moved from apps/platform; same values as platform's file)
# =====================================================================================================================
# /api/webhooks, /api/internal, /api/site, /api/t, /api/leads, /api/pricing, /api/privacy-requests, /api/content-media-uploads,
# /api/product-photos and /content-media are served here after the nginx switch. Copy these from platform.env.local.
# The Cal.com webhook secret (/api/webhooks/calcom): a kickoff call moved or cancelled from Cal.com's email shows on the dashboard.
CALCOM_WEBHOOK_SECRET=
# Bearer tokens of the scheduled jobs, at least 32 characters each. Unset, that route refuses every request.
#   KICKOFF_SYNC_TOKEN         /api/internal/start-builds-after-kickoff
#   PAYMENT_RECONCILE_TOKEN    /api/internal/check-first-payments
#   SITE_ANALYTICS_TOKEN       /api/internal/roll-up-site-analytics and /api/internal/retry-conversions
#   ACCOUNT_ERASE_TOKEN        /api/internal/erase-closed-accounts
#   SITE_HOSTING_SYNC_TOKEN    /api/internal/sync-site-hosting (also needs VERCEL_API_TOKEN, a token for the Digibranders Vercel team)
KICKOFF_SYNC_TOKEN=
PAYMENT_RECONCILE_TOKEN=
SITE_ANALYTICS_TOKEN=
ACCOUNT_ERASE_TOKEN=
SITE_HOSTING_SYNC_TOKEN=
VERCEL_API_TOKEN=
# Unset or "on" starts a website build once a kickoff call's end time has passed; "off" only once staff confirm the call.
KICKOFF_AUTO_START=
# Where privacy request alerts go; default the support inbox.
PRIVACY_ALERT_EMAIL=
# Server-side conversions: each pair is off while either value is unset. META_TEST_EVENT_CODE and META_GRAPH_VERSION are optional.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=
# Vimeo video lookups, optional.
VIMEO_ACCESS_TOKEN=
# Gate G2 (privacy review): whether enquirers' details from website forms and ad leads may be stored. Off unless 1, true, on or yes.
ENQUIRY_FORM_CONTENTS_ENABLED=

# Timer jobs that run from this app (pnpm site-health:run, google:sync, google:provision). Same values as apps/platform's file.
# Google PageSpeed Insights key for the site health job's daily phone speed check. Optional; the anonymous quota is shared.
PAGESPEED_API_KEY=
# The Google pull and go-live jobs sign in as the Brandbasket Google account connected in the console, with this OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_SECOND_OWNER_EMAIL=
GOOGLE_ANALYTICS_TAG_ENABLED=
GOOGLE_ANALYTICS_ACCOUNT_NAME=
# Optional: path of a service account JSON key for a customer's own Analytics property.
GA4_SERVICE_ACCOUNT_JSON=

# =====================================================================================================================
# NEVER SET on a real deployment (the deploy refuses a release whose file has either)
# =====================================================================================================================
# EMAIL_CODE_BYPASS, BRANDBASKET_ALLOW_FAKE_BILLING

DATABASE_URL_PAYLOAD=
PAYLOAD_SECRET=

# Blog media folder shared by apps/platform and apps/customer (absolute). Set the same value in both.
PAYLOAD_MEDIA_DIR=/srv/brandbasket/media/payload

# Gate G1 (counsel's answer and the approved privacy wording on first-party analytics): whether the Website screen and Home show
# visits. Off unless 1, true, on or yes. Read from this app's own environment.
CUSTOMER_VISITS_ENABLED=
# Exactly 1 shows "How people find you on Google" (Search Console numbers, plan 62). Leave unset until the owner approves the words.
CUSTOMER_SEARCH_ENABLED=

# Posting service (social-auto), optional. With both set, Social & Ads gets an Analytics tab that reads how the business's posts
# and accounts did from the service's product API. Without them the tab is not drawn. Same values as apps/platform.
SOCIAL_AUTO_URL=
SOCIAL_AUTO_KEY=
