# apps/customer: the customer app v4 (plan 61). Copy to .env.local for local development.
# It reads the same databases as apps/platform, through the same three roles. The production list, with notes on which values
# must equal platform's, is .env.production.example.
#
# Only the first block is needed to run it; every other value has a safe local default (fake billing, mail written to the
# outbox, no error reporting, uploads under .data/media).

# This app's own origin. Session cookies are host-only, so the app signs people in on this host.
# Local: http://localhost:3197. Staging: https://next.brandbasket.in.
APP_ORIGIN=http://localhost:3197
# The staff console. Local: http://console.brandbasket.localhost:3199.
ADMIN_ORIGIN=http://console.brandbasket.localhost:3199

# bb_app (row-level security), bb_staff (the documented exceptions in src/lib/db.ts) and bb_public (insert-only intake).
DATABASE_URL=
DATABASE_URL_STAFF=
DATABASE_URL_PUBLIC=

# At least 32 characters. Must equal apps/platform's value only if both apps should accept the same sessions on one host.
BETTER_AUTH_SECRET=
# At least 32 characters. Hashes the emailed sign-up codes.
ACCOUNT_CODE_SECRET=

# Local only: any 6-digit code is accepted at sign-up. Ignored on an https deployment.
EMAIL_CODE_BYPASS=
# Unset means the fake provider (no money moves). "razorpay" needs the pair below and a tunnel for the platform's webhook.
BILLING_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mail: without BREVO_API_KEY every message is only written to the outbox, which staff read in the console.
BREVO_API_KEY=
BRANDBASKET_MAIL_FROM=
SUPPORT_ALERT_EMAIL=
SECURITY_ALERT_EMAIL=
BRANDBASKET_TEAM_EMAIL=

# At least 32 characters; shared with the marketing site, also seals the ad landing page's start token. Unset: no prefill.
LEADS_API_TOKEN=
# Tax invoice number prefix, 1 to 3 capital letters or digits.
INVOICE_PREFIX=
# The domain temporary website addresses are made on. Unset means not offered.
CLIENT_SITE_BASE_DOMAIN=

# Support rollout: unset or "on" (everyone), "internal" (only the listed account ids, comma separated), anything else (no one).
BRANDBASKET_SUPPORT_MODE=
BRANDBASKET_SUPPORT_INTERNAL_ACCOUNT_IDS=

# Uploads. Unset, they go to .data/media under the repository. Production uses an absolute path or the R2 settings.
BRANDBASKET_MEDIA_ROOT=
BRANDBASKET_SUPPORT_ROOT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=

# Call booking. Neither set: locally a stand-in offers weekday times; on a real deployment the booking page itself is shown.
CALCOM_API_KEY=
CALENDLY_API_TOKEN=
# OyeChats API address (an origin, not a secret). Unset: Enquiries shows no message counts.
OYECHATS_API_URL=

# Cloudflare Turnstile on sign-in and sign-up. Off while either key is unset.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Sentry. Unset, the SDK stays off. SENTRY_AUTH_TOKEN is read by `next build` only (source map upload).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Build time, public.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_BRANDBASKET_RELEASE=

# Blog (Payload CMS, same database and secret as apps/platform). PAYLOAD_MEDIA_DIR must be the same absolute folder in
# both apps so blog images uploaded here are served to client sites by apps/platform. Unset means ./media (development).
DATABASE_URL_PAYLOAD=postgresql://localhost:5432/brandbasket_platform_payload
PAYLOAD_SECRET=<same value as apps/platform>
PAYLOAD_MEDIA_DIR=

# Gate G1 (counsel's answer and the approved privacy wording on first-party analytics): whether the Website screen and Home show
# visits. Off unless 1, true, on or yes. Read from this app's own environment.
CUSTOMER_VISITS_ENABLED=
# Exactly 1 shows "How people find you on Google" (Search Console numbers, plan 62). Leave unset until the owner approves the words.
CUSTOMER_SEARCH_ENABLED=

# Posting service (social-auto), optional. With both set, Social & Ads gets an Analytics tab that reads how the business's posts
# and accounts did from the service's product API. Without them the tab is not drawn. Same values as apps/platform.
SOCIAL_AUTO_URL=
SOCIAL_AUTO_KEY=

# Public API and jobs moved here from apps/platform (nginx sends /api/webhooks, /api/internal, /api/site, /api/t, /api/leads,
# /api/pricing, /api/privacy-requests, /api/content-media-uploads, /api/product-photos and /content-media to this app).
# The secret of the Razorpay webhook; enter the same value in Razorpay's dashboard webhook. Unset, the route refuses every request.
RAZORPAY_WEBHOOK_SECRET=
# The secret of the Cal.com webhook that reports a kickoff call cancelled or rescheduled (/api/webhooks/calcom).
CALCOM_WEBHOOK_SECRET=
# Bearer tokens for the scheduled jobs, each at least 32 characters (openssl rand -hex 32). Unset, that route refuses every request.
# KICKOFF_SYNC_TOKEN: /api/internal/start-builds-after-kickoff. PAYMENT_RECONCILE_TOKEN: /api/internal/check-first-payments.
# SITE_ANALYTICS_TOKEN: /api/internal/roll-up-site-analytics and retry-conversions. ACCOUNT_ERASE_TOKEN: /api/internal/erase-closed-accounts.
# SITE_HOSTING_SYNC_TOKEN: /api/internal/sync-site-hosting (also needs VERCEL_API_TOKEN, a token for the Digibranders Vercel team).
KICKOFF_SYNC_TOKEN=
PAYMENT_RECONCILE_TOKEN=
SITE_ANALYTICS_TOKEN=
ACCOUNT_ERASE_TOKEN=
SITE_HOSTING_SYNC_TOKEN=
VERCEL_API_TOKEN=
# Unset or "on" starts a website build once a kickoff call's end time has passed; "off" only once staff confirm the call.
KICKOFF_AUTO_START=
# Where the privacy request alerts go; default the support inbox.
PRIVACY_ALERT_EMAIL=
# Server-side conversions. GA4_MEASUREMENT_ID with GA4_API_SECRET, and META_PIXEL_ID with META_CAPI_TOKEN; each pair is off while
# either value is unset. META_TEST_EVENT_CODE (optional) sends to Events Manager's Test Events tab; META_GRAPH_VERSION defaults to v23.0.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=
# Vimeo (blog and site video lookups), optional.
VIMEO_ACCESS_TOKEN=
# Gate G2 (privacy review): whether enquirers' details from website forms and ad leads may be stored. Off unless 1, true, on or yes.
ENQUIRY_FORM_CONTENTS_ENABLED=
