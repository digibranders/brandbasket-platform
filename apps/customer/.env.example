# apps/customer: the customer app v4 (plan 61). Copy to .env.local for local development.
# It reads the same databases as apps/platform, through the same three roles.

# This app's own origin. Session cookies are host-only, so the app signs people in on this host.
# Local: http://localhost:3197. Staging: https://next.brandbasket.in.
APP_ORIGIN=http://localhost:3197

# bb_app (row-level security), bb_staff (the documented exceptions in src/lib/db.ts) and bb_public (insert-only intake).
DATABASE_URL=
DATABASE_URL_STAFF=
DATABASE_URL_PUBLIC=

# At least 32 characters. Must equal apps/platform's value only if both apps should accept the same sessions on one host.
BETTER_AUTH_SECRET=

# Sentry. Unset, the SDK stays off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Entry (sign-in, sign-up, reset, setup links). ACCOUNT_CODE_SECRET must equal apps/platform's (at least 32 characters).
ACCOUNT_CODE_SECRET=
# Local development only: any 6-digit sign-up code is accepted. Refused on a real deployment.
EMAIL_CODE_BYPASS=
# Seals the `start` token on ad landing links (shared with the website's lead API).
LEADS_API_TOKEN=
# Cloudflare Turnstile on the entry forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Brevo. Unset, mail is only written to the outbox.
BREVO_API_KEY=
# Staff console origin, for links in staff alerts. Default https://console.brandbasket.in.
ADMIN_ORIGIN=

# Billing. Unset BILLING_PROVIDER means the fake provider (no money moves, development only).
# razorpay needs RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET. The webhook stays in apps/platform.
BILLING_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Measurement (plan 59). GTM id is inlined at build time; GA4 and Meta are each on only when both of their values are set.
NEXT_PUBLIC_GTM_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
