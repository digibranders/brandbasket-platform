# Brandbasket production environment for apps/platform (the customer dashboard at app.brandbasket.in).
#
# This lists what a Brandbasket deployment sets, and nothing else: it needs none of Brandbasket's directory, video, Google or marketing-website settings. The full list of every variable
# the code can read, Brandbasket's included, is .env.example. NEVER put values in this file: copy it to .env.production (or
# your process manager's environment file) on the server and fill that in. Generate secrets with `openssl rand -hex 32`.
#
# A server reached over https on a public host is a "real deployment": it refuses to start if anything under REQUIRED TO
# START is missing or blank, if the code bypass switch (EMAIL_CODE_BYPASS) is set, and it refuses the fake billing provider
# unless BRANDBASKET_ALLOW_FAKE_BILLING=1.
# NEXT_PUBLIC_* values are read at BUILD time as well: set them before `next build`, not only before
# `next start`.

# =====================================================================================================================
# REQUIRED TO START (checked at boot, apps/platform/instrumentation.ts; the list lives in
# packages/shared/src/lib/production-requirements.ts)
# =====================================================================================================================

# Public URLs. APP_ORIGIN is the dashboard (https://app.brandbasket.in, no path); ADMIN_ORIGIN is the staff console
# (https://console.brandbasket.in), a separate host with its own host-only cookie. Both must be https.
APP_ORIGIN=
ADMIN_ORIGIN=
# The same address as APP_ORIGIN. Inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL=

# PostgreSQL. All four are postgresql:// URLs to the Brandbasket database (and its separate Payload database).
#   DATABASE_URL        the customer app role (row-level security applies)
#   DATABASE_URL_STAFF  the staff role: staff work and background jobs
#   DATABASE_URL_PUBLIC the insert-only role: sign-up codes and account emails are written to the outbox through it
#   DATABASE_URL_PAYLOAD the blog and content database (Payload CMS)
DATABASE_URL=
DATABASE_URL_STAFF=
DATABASE_URL_PUBLIC=
DATABASE_URL_PAYLOAD=

# Secrets, each at least 32 characters, each different: openssl rand -hex 32. Changing BETTER_AUTH_SECRET signs everyone out.
BETTER_AUTH_SECRET=
PAYLOAD_SECRET=
# Hashes every 6-digit code we email (HMAC): at sign-up, a patient's booking, a privacy request. Changing it only invalidates codes already sent.
ACCOUNT_CODE_SECRET=

# Brevo transactional email (https://www.brevo.com). Account mail (sign-up and booking codes, password resets, setup links) is
# delivered through it; without it a real deployment refuses to start. Authenticate the sending domain in Brevo first
# (SPF, DKIM, DMARC for brandbasket.in), or messages are refused or land in spam.
BREVO_API_KEY=

# =====================================================================================================================
# REQUIRED TO TAKE PAYMENTS (checked the first time a checkout opens, not at boot)
# =====================================================================================================================

# Must be set in production. "razorpay" for real payments. The staff console needs the same value and keys.
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A secret you choose; enter the same value in Razorpay's dashboard webhook (events listed in .env.example).
RAZORPAY_WEBHOOK_SECRET=

# =====================================================================================================================
# OPTIONAL: Brandbasket settings
# =====================================================================================================================

# Who customer mail comes from: "Brandbasket" <BRANDBASKET_MAIL_FROM>. Default no-reply@brandbasket.in. Replies go to
# support@brandbasket.in unless SUPPORT_ALERT_EMAIL is set.
BRANDBASKET_MAIL_FROM=
# Inboxes for team alerts (support requests, privacy requests, security alerts). All default to support@brandbasket.in.
SUPPORT_ALERT_EMAIL=
PRIVACY_ALERT_EMAIL=
SECURITY_ALERT_EMAIL=
# Where new-lead notices from the website's form go. Unused unless LEADS_API_TOKEN is set; defaults to the support inbox.
BRANDBASKET_TEAM_EMAIL=

# Tax invoice number prefix: FY (so FY/26-27/000001) unless set. A prefix is its own series: changing it starts a new
# one at 000001 and never touches invoices already issued. 1 to 3 capital letters or digits.
INVOICE_PREFIX=

# The domain "temporary" website addresses are made on (<business>.<this domain>), for a business with no domain of its
# own yet. UNSET MEANS NOT OFFERED: owners are asked for their own domain, and nothing is minted on anyone else's domain.
CLIENT_SITE_BASE_DOMAIN=

# Where uploaded photos and files live. Unset, they go to .data/media under the repository: set a persistent absolute path
# (the same one in the staff console's environment), or the R2 bucket settings below.
BRANDBASKET_MEDIA_ROOT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Private support screenshots: a directory outside BRANDBASKET_MEDIA_ROOT, or all four SUPPORT_R2_* (a separate private
# bucket). The same values in the staff console. A partial set is refused.
BRANDBASKET_SUPPORT_ROOT=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=

# The robot check on sign-in and sign-up (Cloudflare Turnstile). Off while either key is unset. When on, tokens are accepted
# for the hosts of APP_ORIGIN and ADMIN_ORIGIN unless TURNSTILE_HOSTNAMES (comma separated) says otherwise.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Error reporting. Both off while unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# A build identifier shown on error reports.
NEXT_PUBLIC_BRANDBASKET_RELEASE=

# Website lead form: Brandbasket's marketing site can post "get started" enquiries to /api/leads with this token (at least 32
# characters). Unset, the route refuses every request.
LEADS_API_TOKEN=
# The marketing site's URL and contact details, for links back to it. Default to https://brandbasket.in and support@brandbasket.in.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CALENDLY_URL=

# Daily job that erases accounts 30 days after their owners deleted them (docs/account-erasure.md). Unset, the route
# refuses every request. At least 32 characters.
ACCOUNT_ERASE_TOKEN=

# Authorises the nightly job that rolls up the first-party site analytics and deletes hits older than 90 days (POST
# /api/internal/roll-up-site-analytics, see docs/site-analytics.md). Its own secret. At least 32 characters; generate with:
# openssl rand -hex 32. Unset, the route refuses every request.
SITE_ANALYTICS_TOKEN=

# OyeChats: where the OyeChats page reads its leads' conversations from (the OyeChats API address, for example
# https://api.oyechats.example). Unset, the OyeChats page still lists leads but shows no message counts and cannot open a
# conversation. Never a secret: each bot's own key is stored per bot in the staff console (docs/operations/oyechats.md).
OYECHATS_API_URL=

# =====================================================================================================================
# OFF FOR BRANDBASKET: features that stay in the code but are switched off. Leave all of these unset.
# =====================================================================================================================
# The directory (DIRECTORY_URL_KEY, GEO_CATALOG_SOURCE), business videos (VIMEO_ACCESS_TOKEN), Google Business import
#   (GOOGLE_BUSINESS_CLIENT_ID, GOOGLE_BUSINESS_CLIENT_SECRET), MARKETING_ORIGIN.
# Never set on a real deployment: EMAIL_CODE_BYPASS, BRANDBASKET_ALLOW_FAKE_BILLING (the server refuses to start with the bypass,
#   and refuses fake billing).

# The kickoff call's own calendar on the dashboard home. Set the booking link in the staff console (Settings) to the
# event's Cal.com link (https://cal.com/<user>/<event>) and put that account's API key here (Cal.com, Settings, Security).
# Unset means the booking page itself is shown instead. A Calendly link works the same way with CALENDLY_API_TOKEN (needs a
# paid Calendly plan). Locally, with neither set, a stand-in offers weekday times so the screen can be tried.
CALCOM_API_KEY=
# The secret of the Cal.com webhook (Cal.com, Settings, Developer, Webhooks) that sends booking cancelled and rescheduled
# to /api/webhooks/calcom, so a kickoff call moved or cancelled from Cal.com's email shows the same on the dashboard.
CALCOM_WEBHOOK_SECRET=
CALENDLY_API_TOKEN=
