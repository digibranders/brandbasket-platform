# The platform (apps/platform): customer app, staff admin and their API routes.
# Run `pnpm env:init` to generate .env.local for local development; scripts and tests read the same file.
# This file lists every variable so production configuration can be checked against it.

# Public URL of the marketing website (its own repository), for links back to it. Required in production.
NEXT_PUBLIC_SITE_URL=

# This app's customer host, e.g. https://app.firstfold.com. Required in production.
NEXT_PUBLIC_APP_URL=

# Optional contact email, used as the security.txt contact. Unset means the registered business email in
# packages/shared/src/lib/site-config.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# Migrations and role setup (a Postgres role allowed to create roles and tables).
DATABASE_URL_OWNER=
DATABASE_URL_OWNER_TEST=

# Passwords for the firstfold_app and firstfold_staff roles.
FIRSTFOLD_APP_PASSWORD=
FIRSTFOLD_STAFF_PASSWORD=

# Runtime connections: firstfold_app (row-level security) and firstfold_staff (staff and system work).
DATABASE_URL=
DATABASE_URL_STAFF=
DATABASE_URL_TEST=
DATABASE_URL_STAFF_TEST=

# Enquiries from the website (POST /api/leads) are stored through the insert-only firstfold_public role.
DATABASE_URL_PUBLIC=
DATABASE_URL_PUBLIC_TEST=
FIRSTFOLD_PUBLIC_PASSWORD=

# Shared with the website repository, which sends Get started enquiries with it. At least 32 characters.
# Generate with: openssl rand -hex 32. Required in production.
LEADS_API_TOKEN=

# Authorises the daily job that erases accounts 30 days after their owners deleted them (POST
# /api/internal/erase-closed-accounts, see docs/account-erasure.md). Its own secret, not LEADS_API_TOKEN, because it deletes
# data. At least 32 characters; generate with: openssl rand -hex 32. Unset, the route refuses every request.
ACCOUNT_ERASE_TOKEN=

# Inbox that receives lead notifications (e.g. support@firstfold.io). Required in production.
FIRSTFOLD_TEAM_EMAIL=

# Brevo transactional email. When BREVO_API_KEY is set, these emails go out through Brevo (API v3): support, reply and
# error alerts to the team, new-lead and preview-response notices to FIRSTFOLD_TEAM_EMAIL. A copy is also recorded in the
# database outbox (alerts about support requests keep only the reference, category, status and a link there). When it is
# unset, every email is only recorded in the outbox, which staff read in the console. A Brevo failure never fails the
# request that triggered it: the email is recorded in the outbox instead.
# BEFORE you set the key in production: authenticate the firstfold.io domain in Brevo (SPF, DKIM and DMARC DNS records)
# and add ALERTS_FROM_EMAIL (alerts@firstfold.io by default) as a sender. It is only a From address and needs no
# mailbox; replies go to the support mailbox below. Without an authenticated domain Brevo will refuse or spam-folder
# every message.
BREVO_API_KEY=
# Who customer mail comes from. Left unset these follow PLATFORM_BRAND: alerts@firstfold.io, or on a Fynix server
# (PLATFORM_BRAND=fynix) alerts@fynix.digital with replies to hello@fynix.digital. Authenticate whichever domain sends.
# On a Fynix server mail is sent as "Fynix Digital" from FYNIX_MAIL_FROM (default no-reply@fynix.digital); authenticate that
# domain in Brevo (SPF, DKIM, DMARC) before setting BREVO_API_KEY in production.
FYNIX_MAIL_FROM=
ALERTS_FROM_EMAIL=alerts@firstfold.io
ALERTS_FROM_NAME=Firstfold Alerts
# Mailbox that receives support alerts and is the reply-to address (falls back to FIRSTFOLD_TEAM_EMAIL, then
# support@firstfold.io). Support alert emails include the request text so staff can triage; see docs/operations/support-attachments.md.
SUPPORT_ALERT_EMAIL=support@firstfold.io
# Where new privacy requests and the nightly "due soon" email go. Falls back to SUPPORT_ALERT_EMAIL. The emails carry a
# reference, a kind and a date, never a name or number. The nightly one runs in the support maintenance command.
PRIVACY_ALERT_EMAIL=
# Where security alerts go: bursts of blocked sign-ins, payment notices with a bad signature, and the nightly staff access
# review. Falls back to SUPPORT_ALERT_EMAIL. They carry no customer data. See docs/operations/security-alerts.md.
SECURITY_ALERT_EMAIL=

# Private support screenshots. Locally they go to FIRSTFOLD_SUPPORT_ROOT (default .data/support-private), which must sit
# outside FIRSTFOLD_MEDIA_ROOT. It must be the SAME absolute directory in the platform and the admin app when storage is
# local, or staff cannot open customers' screenshots. For production, set ALL FOUR SUPPORT_R2_* values (the same four in
# both apps) to use a private bucket; SUPPORT_R2_BUCKET must NOT be R2_BUCKET. A partial set is refused, not ignored.
# See docs/operations/support-attachments.md.
FIRSTFOLD_SUPPORT_ROOT=
SUPPORT_R2_ACCOUNT_ID=
SUPPORT_R2_ACCESS_KEY_ID=
SUPPORT_R2_SECRET_ACCESS_KEY=
SUPPORT_R2_BUCKET=
# Closed support requests are deleted, with their notes and screenshots, 24 months after closing (the retention schedule,
# docs/operations/retention-schedule.md). Set a whole number of months (1 to 120) only to change that. Read by the scheduled
# command `pnpm support:attachments:maintain` only.
# SUPPORT_TICKET_RETENTION_MONTHS=24

# Who may send new support requests: leave commented out (or "on") for everyone, "internal" for only the account ids
# listed below (comma separated), anything else turns new requests off. Existing conversations stay readable. Do not
# set this to an empty value: an empty value turns new requests off.
# FIRSTFOLD_SUPPORT_MODE=on
# FIRSTFOLD_SUPPORT_INTERNAL_ACCOUNT_IDS=

# Git commit hash (7 to 64 hex characters) of the deploy, set before the build and kept at runtime. Tags the native
# automatic errors inbox (docs/operations/automatic-errors.md). Unset or invalid becomes "unknown". Set the same value for
# the admin app.
NEXT_PUBLIC_FIRSTFOLD_RELEASE=

# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Who takes payments. Accepted values: fake (a local test checkout; no money moves) or razorpay.
# Optional in development, where unset means fake. Required in production: an unset value stops the app rather
# than taking payments with the fake provider. The fake provider is also refused on a real deployment
# (VERCEL_ENV=production, or an https APP_ORIGIN whose host is not localhost), because it hands out paid access
# without taking money. The local verify server (http://app.localhost:3101) is not a real deployment and needs
# nothing extra. The staff console (apps/admin) needs the same BILLING_PROVIDER and keys, to put prices on sale.
BILLING_PROVIDER=

# Required when BILLING_PROVIDER=razorpay. From the Razorpay dashboard (Account & Settings > API Keys): rzp_test_ keys
# in test mode, rzp_live_ keys in live mode. Read when a page is served, never at build time, so the build needs
# neither. The key id is not secret: the payment pages hand it to Razorpay Checkout in the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required when BILLING_PROVIDER=razorpay. A secret you choose (openssl rand -hex 32), entered in the Razorpay
# dashboard (Account & Settings > Webhooks) for the webhook POST {APP_ORIGIN}/api/webhooks/razorpay, with these ten
# events: subscription.authenticated, subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.paused, subscription.resumed, subscription.cancelled, subscription.completed and
# order.paid. Monthly plans are recorded from subscription.charged, every one-off charge (extras, ad spots, listing
# promotions, upgrades) from order.paid; no payment.* event is needed. Test and live mode each have their own webhook
# and secret, and live mode must capture payments automatically (Account & Settings > Payment capture).
RAZORPAY_WEBHOOK_SECRET=

# Set to exactly 1 to let the fake provider run on a real deployment anyway, for a private test deployment only.
# Leave unset everywhere else.
FIRSTFOLD_ALLOW_FAKE_BILLING=

# The two hosts this app serves: the customer app and the staff admin. Required in production.
APP_ORIGIN=
ADMIN_ORIGIN=

# Optional. A second host for this same dashboard, sold under Fynix Digital's name with Care and Premium only (no free
# listing), e.g. https://app.fynix.digital. Same database and accounts. Unset: the host is off and nothing changes.
# Under `next dev`, any localbusiness.*.localhost address is the Fynix one without this. Production also needs the host
# added to the Razorpay checkout/callback allow-list and the Google Business redirect URIs.
LOCAL_BUSINESS_ORIGIN=
# A deployment that serves ONE brand only sets it here: PLATFORM_BRAND=fynix makes every host this server answers wear
# Fynix's name, logo and plans (Care and Premium), so it needs no LOCAL_BUSINESS_ORIGIN; APP_ORIGIN is then its own host
# (https://app.fynix.digital). Unset is Firstfold. Anything but firstfold or fynix stops the app at start.
PLATFORM_BRAND=

# The parent domain the marketing website shares with the dashboard (firstfold.io in production). Signing in sets a
# small "signed in" marker cookie for it, holding only the person's initials, so the website's header shows Leads and
# Dashboard instead of Log in. Leave empty locally: the website and the dashboard both run on localhost there.
SIGNED_IN_HINT_DOMAIN=

# Payload CMS: a separate database from the main one, on purpose (see docs/superpowers/plans/2026-09-17-payload-cms-migration.md's Architecture section).
DATABASE_URL_PAYLOAD=postgresql://localhost:5432/firstfold_payload
PAYLOAD_SECRET=<generate with: openssl rand -base64 32>

# Where uploaded media is stored on disk, absolute. Both apps must point at the SAME directory: the customer
# uploads through this app and staff read it back through apps/admin. Unset falls back to <workspace root>/.data/media,
# which is right for a checkout; set it explicitly in production.
FIRSTFOLD_MEDIA_ROOT=

# Premium members' short videos (docs/superpowers/specs/2026-10-07-business-videos-design.md) are hosted on Vimeo, as
# unlisted videos in Firstfold's own account. A Vimeo API access token, from developer.vimeo.com > My Apps > your app >
# Generate an access token: choose "Authenticated (you)" and tick the scopes public, private, upload, edit and delete.
# Videos are made inside the account's "Firstfold" folder (make it in Vimeo first). The admin app needs the SAME token (a staff take-down deletes the video from Vimeo). Unset, video uploads answer
# "not available" and everything else works.
VIMEO_ACCESS_TOKEN=

# Optional: uploaded pictures and logos live on local disk under FIRSTFOLD_MEDIA_ROOT. With all four R2_* set they live in
# a private Cloudflare R2 bucket instead (an Account API token with Object Read & Write, limited to that bucket). Set all
# four or none: a half-set list stops the app at its first media request, naming what is missing. The admin app needs the
# same four.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Slot-booking OTP (POST /api/site/bookings/otp, /api/site/bookings/confirm). At least 32 random characters,
# used to HMAC-SHA256 every booking OTP code before it is stored -- never the code itself. Generate with:
# openssl rand -hex 32. Read lazily (only once a booking endpoint runs), so no other page needs it set, but
# required in production wherever the appointments module is used.
BOOKING_OTP_SECRET=

# Who sends the booking OTP SMS. Accepted values: outbox (the default; records into sms_messages instead of
# sending -- the admin outbox page's SMS section is the only place the code is visible locally). Blank or unset
# both mean outbox. "msg91" texts through MSG91's Flow API (needs the three MSG91_* values below); see
# apps/platform/lib/server/sms/index.ts for adding another -- and see SMS_ALLOWED_COUNTRY_CODES below.
SMS_PROVIDER=outbox

# Only with SMS_PROVIDER=msg91. The auth key from the MSG91 dashboard, and the id of the DLT-registered template MSG91
# holds for the one text every code is sent with: "##code## is your Firstfold code. It expires in 10 minutes. Do not
# share it." (one variable, named code). The wording must match what was registered word for word.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# TEMPORARY switches for local development, ignored wherever real customers can reach the app (an https APP_ORIGIN on a
# public host, or Vercel production). A real deployment refuses to start with any of them set. Leave unset for real codes.
#
# "true" sends no SMS and accepts ANY 6-digit code on the booking form: phone numbers are then not verified.
BOOKING_OTP_BYPASS=

# "true" sends no SMS and accepts ANY 6-digit code when an account is created on the entry page (/login): the mobile
# number is then not proven to be the owner's. It never applies to a password reset, whose code is always texted and
# checked.
SIGNUP_OTP_BYPASS=

# "true" accepts ANY 6-digit code in the Fynix email sign-up (PLATFORM_BRAND=fynix): the email address is then not proven
# to be the owner's. The code is still emailed (to the outbox locally). Never applies to a password reset, which is a link.
EMAIL_CODE_BYPASS=

# "true" lets an owner mark their own business Verified (Business profile > Review) with ANY 6-digit code, and sends no
# SMS. Verified is the top tier of the directory's ranking, so anyone signed in to a claimed business could take it.
# Unset, the code is texted and checked.
VERIFY_OTP_BYPASS=

# Comma-separated calling codes (no "+"), e.g. "91,1". Booking OTP SMS are only ever sent to a number in one of
# these countries; a booking request for any other number is refused before it can spend a real SMS provider's
# budget. Defaults to "91" (India only) when unset or blank. This is the anti SMS-pumping (toll fraud) guard --
# widen it deliberately, not by leaving it unset, once a real provider is live for more countries.
SMS_ALLOWED_COUNTRY_CODES=

# "Import from Google Business Profile" on the free listing account's Business profile (Details tab). An OAuth client
# of type "Web application" in Google Cloud, with the Business Profile APIs (My Business Account Management and My
# Business Business Information) enabled AND approved for the project by Google (request access: their quota is 0
# until then). Authorised redirect URI: <APP_ORIGIN>/google-business/callback. Set both or neither: blank leaves the
# button off ("Not connected yet") and everything else on the Business profile works.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# Key for business URL codes, /in/mh/business/<name>/<code> (packages/db/src/place-id.ts). MUST equal the website's
# DIRECTORY_URL_KEY (32+ characters). Left empty, the website's interim key is used, as on the website: set both together,
# once, since changing it changes every business URL.
DIRECTORY_URL_KEY=

# Where the directory's areas, categories and opened districts come from: "file" (packages/shared places.json, the
# default) or "db" (the geo_* tables edited on the staff console's Geography page). Set it on BOTH apps; the database
# read falls back to the file lists while the tables are empty.
GEO_CATALOG_SOURCE=file

# Sentry (apps/platform, project firstfold-platform). NEXT_PUBLIC_SENTRY_DSN is read by the browser, so it is public.
# SENTRY_DSN is read on the server and in the edge runtime. Leave both unset to keep Sentry off. Sentry is an outside
# processor: Replay is disabled and events are scrubbed of customer text first (docs/operations/automatic-errors.md).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Set SENTRY_RELEASE to a build identifier (the VPS build sets it to the release name) so events match the uploaded source maps.
# Build-time only: uploads source maps on `next build`. Create a token with project:releases scope. Never commit it.
SENTRY_AUTH_TOKEN=

# Optional domain-bound OTP SMS: approve the exact two-variable template before setting a surface's pair.
# Both values blank keep the existing MSG91_TEMPLATE_ID and message. Set both or neither for each surface;
# account creation/recovery/business verification use APP, public directory reviews/comments use WEBSITE.
# These are fixed trusted HTTPS browser origins (e.g. https://app.firstfold.io and https://www.firstfold.io),
# with no port/path/query/fragment. Never derive them from a request Host header. See docs/otp-autofill.md.
# The MSG91 Flow templates substitute code and binding_code with the SAME OTP; final line:
# @<fixed-host> #<binding_code> Firstfold
SMS_OTP_APP_ORIGIN=
MSG91_OTP_APP_TEMPLATE_ID=
SMS_OTP_WEBSITE_ORIGIN=
MSG91_OTP_WEBSITE_TEMPLATE_ID=

# Cloudflare Turnstile, the robot check on the sign-in, sign-up, password and setup forms. Both keys come from the widget in
# the Cloudflare dashboard (its domains: firstfold.io, app.firstfold.io, admin.firstfold.io). Unset, the check is off and
# the forms work as before. Set the same two on the website and on both apps. TURNSTILE_HOSTNAMES (comma separated) is
# optional: the hostnames a token may be solved on, defaulting to those three plus www.firstfold.io.
# Development ignores the keys, because the real widget refuses localhost. To try the widget locally set
# TURNSTILE_ENABLE_IN_DEVELOPMENT=true with Cloudflare's test keys (1x00000000000000000000AA and
# 1x0000000000000000000000000000000AA).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
