#!/usr/bin/env bash
# CI for pushes to brandbasket-platform, run on the VPS because GitHub Actions cannot run for it. Installed as
# /usr/local/bin/brandbasket-ci (root-owned) and run as `deploy` every minute by brandbasket-ci.timer. Adapted from
# Firstfold's firstfold-ci (one repository instead of two).
#
#   brandbasket-ci            check every new branch head (what the timer runs)
#   brandbasket-ci --status   what has been checked and what is waiting
#
# Every branch except main (main is checked by its deploy) is fetched into /srv/brandbasket-ci/mirrors with the repository's
# read-only deploy key (host alias github-brandbasket-platform). A head commit not checked before is run through
# brandbasket-ci-sandbox (as the locked-down user bbci, no secrets, no local network) and reported to GitHub by
# ci-checks.py as one check run per step, "CI: install", "CI: lint", "CI: typecheck", "CI: test", "CI: build", so a pull
# request's Checks tab shows each. The first run records the branches as they are without checking them, except
# development; from then on every push is checked.
#
# One heavy job at a time on the box: before a commit is checked this takes Brandbasket's lock and all three of Firstfold's
# (heavy-lock.sh) without waiting, and gives them back after the commit. If any is busy (a Firstfold or Brandbasket deploy or
# CI run), it prints one line and exits 0; the commit is not marked as checked, so the next minute tries again. Holding
# Firstfold's locks makes its timers skip quietly.
set -euo pipefail

readonly CI_ROOT=/srv/brandbasket-ci
readonly LIB=/usr/local/lib/brandbasket
readonly FF_LIB=/usr/local/lib/firstfold
readonly STEPS=(install lint typecheck test build)
readonly GH_REPO=digibranders/brandbasket-platform
readonly REMOTE=git@github-brandbasket-platform:digibranders/brandbasket-platform.git
readonly MIRROR="$CI_ROOT/mirrors/platform.git"
readonly CHECKED="$CI_ROOT/state/platform.checked"

die() { echo "error: $*" >&2; exit 1; }
[[ "$(id -un)" == deploy ]] || die "run as deploy"
cd "$CI_ROOT"

fetch() {
  if [[ ! -d "$MIRROR" ]]; then
    git init --quiet --bare "$MIRROR"
    git -C "$MIRROR" remote add origin "$REMOTE"
  fi
  timeout 120 git -C "$MIRROR" fetch --quiet --prune origin '+refs/heads/*:refs/heads/*'
}

# "<sha> <branch>" for every branch head except main, newest commit first; a commit on several branches once.
heads() {
  git -C "$MIRROR" for-each-ref --sort=-committerdate --format='%(objectname) %(refname:short)' refs/heads \
    | awk '$2 != "main" && !seen[$1]++'
}

if [[ "${1:-}" == --status ]]; then
  [[ -d "$MIRROR" ]] || { echo "not fetched yet"; exit 0; }
  while read -r sha branch; do
    if grep -qx "$sha" "$CHECKED" 2>/dev/null; then mark="checked"; else mark="waiting"; fi
    printf '  %-8s %s %s\n' "$mark" "${sha:0:7}" "$branch"
  done < <(heads)
  exit 0
fi
[[ $# -eq 0 ]] || die "unknown option: $1"

exec 9>"$CI_ROOT/.ci.lock"
flock -n 9 || exit 0

# shellcheck source=/dev/null
source "$FF_LIB/github-status.sh"
# shellcheck source=../heavy-lock.sh
source "$LIB/heavy-lock.sh"

check_commit() {
  local sha=$1 branch=$2 log state rc
  log="$(mktemp)"; state="$(mktemp)"
  echo "checking $branch at $sha"
  git -C "$MIRROR" archive "$sha" > "$CI_ROOT/archives/$sha.tar"
  gh_init "$GH_REPO"

  # One check run per step with the app; a single "CI" commit status with the plain token.
  if [[ "$GH_AUTH" == app ]]; then
    progress() { GH_TOKEN="$GH_TOKEN" python3 "$LIB/ci-checks.py" "$state" "$log" "$GH_REPO" "$sha" "$branch" progress 0 "${STEPS[@]}"; }
  else
    progress() { :; }
    gh_check_start "$GH_REPO" "$sha" CI "Running lint, typecheck, test and build on the VPS" >/dev/null
  fi
  progress

  if gh_run_logged "$log" progress sudo -n /usr/local/sbin/brandbasket-ci-sandbox "$sha"; then rc=0; else rc=$?; fi
  # Passed only if the checks said so at the end (see ci-steps.sh); otherwise the run was stopped or timed out.
  if [[ "$rc" == 0 ]] && ! grep -q ' == result: passed$' "$log"; then
    echo "the checks stopped before finishing" | while IFS= read -r line; do printf '%(%s)T %s\n' -1 "$line" >> "$log"; done
    rc=1
  fi

  if [[ "$GH_AUTH" == app ]]; then
    GH_TOKEN="$GH_TOKEN" python3 "$LIB/ci-checks.py" "$state" "$log" "$GH_REPO" "$sha" "$branch" final "$rc" "${STEPS[@]}"
  elif [[ "$rc" == 0 ]]; then
    gh_check_update "$GH_REPO" "$sha" "" CI success "$(gh_json title "Passed: lint, typecheck, test, build")"
  else
    gh_check_update "$GH_REPO" "$sha" "" CI failure "$(gh_json title "Failed. Log: journalctl -u brandbasket-ci on the VPS")"
  fi
  rm -f "$log" "$state" "$CI_ROOT/archives/$sha.tar"
  echo "checked $branch at $sha: $([[ "$rc" == 0 ]] && echo passed || echo "failed ($rc)")"
}

fetch
if [[ ! -f "$CHECKED" ]]; then
  heads | awk '$2 != "development" {print $1}' > "$CHECKED"
  echo "first run: recorded $(wc -l < "$CHECKED") existing branch heads without checking them"
fi

while read -r sha branch; do
  grep -qx "$sha" "$CHECKED" && continue
  if ! bb_take_heavy_locks 0; then
    echo "another build, deploy or CI run is going ($BB_LOCK_BUSY is held); checking again next minute"
    exit 0
  fi
  # Recorded before the run, so a commit that crashes the run is not retried every minute.
  echo "$sha" >> "$CHECKED"
  check_commit "$sha" "$branch"
  bb_release_heavy_locks
done < <(heads)
tail -n 1000 "$CHECKED" > "$CHECKED.new" && mv "$CHECKED.new" "$CHECKED"
