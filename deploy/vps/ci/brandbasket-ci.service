# Checks new branch heads of brandbasket-platform and reports them to GitHub (brandbasket-ci). Started every minute by
# brandbasket-ci.timer; systemd never starts it twice at once. The checks themselves run in a separate sandboxed unit
# (brandbasket-ci-sandbox) with their own limits. Logs: journalctl -u brandbasket-ci
[Unit]
Description=Brandbasket CI: check new pushes to every branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/brandbasket-ci
Environment=HOME=/home/deploy
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
ExecStart=/usr/local/bin/brandbasket-ci
Nice=10
TimeoutStartSec=3h
