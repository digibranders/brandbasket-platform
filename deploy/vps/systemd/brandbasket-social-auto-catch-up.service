# Pulls the events social-auto holds that its webhook did not deliver: POSTs to the dashboard's own /api/internal/social-auto-catch-up on
# 127.0.0.1 with EMAIL_QUEUE_TOKEN from the environment file (the email queue's job script, pointed at another URL), and prints the
# report. It reads after the stored seq in pages of 100 and acts on each event id once, so it is safe to run as often as wanted. Without
# SOCIAL_AUTO_WEBHOOK_SECRET or SOCIAL_AUTO_URL it does nothing and succeeds. By hand:
#   runuser -u brandbasket -- /usr/local/sbin/brandbasket-email-queue-job --env-file /srv/brandbasket/shared/customer.env.production --url http://127.0.0.1:3202/api/internal/social-auto-catch-up
[Unit]
Description=Brandbasket catch up on missed social-auto events
After=brandbasket-customer.service

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
ExecStart=/usr/local/sbin/brandbasket-email-queue-job --env-file /srv/brandbasket/shared/customer.env.production --url http://127.0.0.1:3202/api/internal/social-auto-catch-up
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-social-auto-catch-up
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
