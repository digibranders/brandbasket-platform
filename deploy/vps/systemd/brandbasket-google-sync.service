# The Google pull (plans 61 and 62): `pnpm google:sync` reads, through the Brandbasket Google account connected in the console
# (Settings, Google account), the daily visits, key events, channels and pages from Google Analytics and the daily clicks,
# impressions, position, top searches and pages from Search Console, for every business with a property or site on record, and
# stores them as ga4 and gsc numbers in metric_daily and metric_breakdowns. Installed by deploy/vps/install.sh but NOT enabled:
# enabling it is the owner's call, after the Google steps in docs/deployment/brandbasket-vps.md ("Google"). It reads the
# dashboard's environment through the release's apps/customer/.env.production link, as the site health job does, so it needs a
# deployed release, and GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET in that environment. It writes only to the database.
# By hand:
#   systemctl start brandbasket-google-sync.service && journalctl -u brandbasket-google-sync -n 20
# (a good run prints lines starting "Google Analytics:" and "Search Console:").
[Unit]
Description=Brandbasket Google pull (Analytics and Search Console)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
WorkingDirectory=/srv/brandbasket/current-customer
CacheDirectory=brandbasket-google-sync
Environment=HOME=/var/cache/brandbasket-google-sync
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ExecStart=/usr/bin/env pnpm --filter @brandbasket/customer google:sync
Nice=10
IOWeight=20
TimeoutStartSec=15min
MemoryMax=400M
LimitNOFILE=65535
SyslogIdentifier=brandbasket-google-sync
# Sandbox (Firstfold's app hardening): read-only system, no writable paths, no privileges, no unneeded syscalls. Firstfold's
# folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores a path that is not
# there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
