# Runs the Brandbasket staff console (apps/admin) on port 3203, behind nginx, as the deploy user. nginx serves it only to
# requests that came through Cloudflare. Installed to /etc/systemd/system/ by deploy/vps/install.sh services.
# /srv/brandbasket/current-admin is a symlink to the live release (brandbasket-platform-release moves it and restarts this
# unit); the release's apps/admin/.env.local is a link to /srv/brandbasket/shared/admin.env.local. Until the first deploy
# there is no release: the unit is enabled and not started.
[Unit]
Description=Brandbasket staff console (apps/admin)
After=network-online.target postgresql.service
Wants=network-online.target
# Three failed starts in a minute is a broken release, not a blip: stop and let the release script (or a person) decide.
# (These two belong in [Unit]; in [Service] systemd ignores them.)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/brandbasket/current-admin/apps/admin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=384
# No -H flag, on purpose (see brandbasket-app.service): port 3203 stays closed to the outside through ufw.
ExecStart=/srv/brandbasket/current-admin/apps/admin/node_modules/.bin/next start -p 3203
Restart=on-failure
RestartSec=3
MemoryHigh=500M
MemoryMax=650M
OOMScoreAdjust=300
TasksMax=256
TimeoutStopSec=20
SyslogIdentifier=brandbasket-admin
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
