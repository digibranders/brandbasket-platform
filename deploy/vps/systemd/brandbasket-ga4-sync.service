# The Google Analytics pull (plan 61, gate G1): `pnpm ga4:sync` reads the daily visits, key events, channels and pages of every
# business whose Google Analytics property staff set in the console (client, Website tab), through a Google service account the
# customer added as a Viewer, and stores them as ga4 numbers in metric_daily and metric_breakdowns. Installed by
# deploy/vps/install.sh but NOT enabled: enabling it is the owner's call, after the Google Cloud steps in
# docs/deployment/brandbasket-vps.md ("Google Analytics"). It reads the dashboard's environment through the release's
# apps/platform/.env.local link, as the site health job does, so it needs a deployed release, and GA4_SERVICE_ACCOUNT_JSON in
# that environment (the path of the key file, which only the brandbasket user may read). It writes only to the database.
# By hand:
#   systemctl start brandbasket-ga4-sync.service && journalctl -u brandbasket-ga4-sync -n 20
# (a good run prints a line starting "Google Analytics:").
[Unit]
Description=Brandbasket Google Analytics pull (visits, channels, pages)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
WorkingDirectory=/srv/brandbasket/current-platform
CacheDirectory=brandbasket-ga4-sync
Environment=HOME=/var/cache/brandbasket-ga4-sync
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ExecStart=/usr/bin/env pnpm ga4:sync
Nice=10
IOWeight=20
TimeoutStartSec=15min
MemoryMax=400M
LimitNOFILE=65535
SyslogIdentifier=brandbasket-ga4-sync
# Sandbox (Firstfold's app hardening): read-only system, no writable paths, no privileges, no unneeded syscalls. Firstfold's
# folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores a path that is not
# there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
