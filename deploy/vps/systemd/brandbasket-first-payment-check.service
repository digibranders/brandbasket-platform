# The first payment check: POSTs to the dashboard's own /api/internal/check-first-payments on 127.0.0.1 with the
# bearer token from the environment file. It asks Razorpay about every checkout still waiting for its first
# payment and records any it holds, for a payment whose webhook never arrived. Enabled on install by deploy/vps/install.sh:
# set PAYMENT_RECONCILE_TOKEN in /srv/brandbasket/shared/customer.env.production (make-env-files.sh generates it for a
# new server; an existing one needs `openssl rand -hex 32`), start the service once and read its journal.
# brandbasket-first-payment-check-job keeps the token out of the process list. It writes nothing itself (the app records the
# payment), so this unit has no writable paths.
[Unit]
Description=Brandbasket check for first payments whose webhook never arrived
After=brandbasket-customer.service

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
ExecStart=/usr/local/sbin/brandbasket-first-payment-check-job --env-file /srv/brandbasket/shared/customer.env.production
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-first-payment-check
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
