# Go live for Google (plan 62): `pnpm google:provision` gives every live site on its own domain an Analytics property, a verified Search
# Console site (through a meta tag the site serves, set as an environment variable on the client's Vercel project, then one redeploy)
# and the second owner. Safe to run again and again: each step stores what it did and a finished business is left alone. A free
# address never gets a property. Installed by deploy/vps/install.sh but NOT enabled: enabling it is the owner's call, after the
# Google steps in docs/deployment/brandbasket-vps.md ("Google") and a read of `pnpm google:provision -- --dry-run`. Needs the
# Setting up sites sign-in connected in the console, VERCEL_API_TOKEN, GOOGLE_ACCOUNT_EMAIL and GOOGLE_OAUTH_CLIENT_ID and
# GOOGLE_OAUTH_CLIENT_SECRET in the dashboard's environment (read through the release's apps/customer/.env.production link).
# By hand:
#   systemctl start brandbasket-google-provision.service && journalctl -u brandbasket-google-provision -n 20
# (a good run prints a line starting "Google go live:").
[Unit]
Description=Brandbasket Google go live (Analytics property, Search Console, owners)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
WorkingDirectory=/srv/brandbasket/current-customer
CacheDirectory=brandbasket-google-provision
Environment=HOME=/var/cache/brandbasket-google-provision
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ExecStart=/usr/bin/env pnpm --filter @brandbasket/customer google:provision
Nice=10
IOWeight=20
TimeoutStartSec=14min
MemoryMax=400M
LimitNOFILE=65535
SyslogIdentifier=brandbasket-google-provision
# Sandbox (Firstfold's app hardening): read-only system, no writable paths, no privileges, no unneeded syscalls. Firstfold's
# folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores a path that is not
# there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
