# Sends the emails Brevo did not take the first time: POSTs to the dashboard's own /api/internal/drain-email-queue on 127.0.0.1 with the
# bearer token from the environment file, and prints the report (claimed, sent, requeued, failed, suppressed). A queued message gets
# three attempts in all with backoff, then shows as failed on Today and Deliveries. Safe to run as often as wanted: a message is
# claimed by one run at a time. EMAIL_QUEUE_TOKEN is in /srv/brandbasket/shared/customer.env.production (make-env-files.sh generates it;
# add it by hand to a file made earlier). brandbasket-email-queue-job keeps the token out of the process list. By hand:
#   runuser -u brandbasket -- /usr/local/sbin/brandbasket-email-queue-job --env-file /srv/brandbasket/shared/customer.env.production
[Unit]
Description=Brandbasket send queued emails
After=brandbasket-customer.service

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
ExecStart=/usr/local/sbin/brandbasket-email-queue-job --env-file /srv/brandbasket/shared/customer.env.production
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-email-queue
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
