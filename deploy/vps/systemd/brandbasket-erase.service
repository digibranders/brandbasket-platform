# The daily erase of accounts whose owners asked to delete them 30 days ago (docs/account-erasure.md): POSTs to the
# dashboard's own /api/internal/erase-closed-accounts on 127.0.0.1 with the bearer token from the environment file.
# Installed by deploy/vps/install.sh backups but NOT enabled: it deletes customer data, so starting the timer is the
# owner's call. ACCOUNT_ERASE_TOKEN is in /srv/brandbasket/shared/platform.env.local (make-env-files.sh generates it).
# brandbasket-erase-job keeps the token out of the process list. It writes nothing itself (the app does the erasing), so this
# unit has no writable paths. Dry run by hand:
#   runuser -u brandbasket -- /usr/local/sbin/brandbasket-erase-job --env-file /srv/brandbasket/shared/platform.env.local --dry-run
[Unit]
Description=Brandbasket daily erase of closed accounts
After=brandbasket-app.service

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
ExecStart=/usr/local/sbin/brandbasket-erase-job --env-file /srv/brandbasket/shared/platform.env.local
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-erase
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
