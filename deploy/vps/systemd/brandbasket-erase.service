# The daily erase of accounts whose owners asked to delete them 30 days ago (docs/account-erasure.md): POSTs to the
# dashboard's own /api/internal/erase-closed-accounts on 127.0.0.1 with the bearer token from the environment file.
# Installed by deploy/vps/install.sh backups but NOT enabled: it deletes customer data, so starting the timer is the
# owner's call. ACCOUNT_ERASE_TOKEN is in /srv/brandbasket/shared/platform.env.local (make-env-files.sh generates it).
# brandbasket-erase-job keeps the token out of the process list. Dry run by hand:
#   sudo -u deploy /usr/local/sbin/brandbasket-erase-job --env-file /srv/brandbasket/shared/platform.env.local --dry-run
[Unit]
Description=Brandbasket daily erase of closed accounts
After=brandbasket-app.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/sbin/brandbasket-erase-job --env-file /srv/brandbasket/shared/platform.env.local
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-erase
NoNewPrivileges=true
PrivateTmp=true
