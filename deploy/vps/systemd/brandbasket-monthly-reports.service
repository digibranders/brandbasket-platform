# The monthly reports job (plan 58): `pnpm reports:run` writes last month's customer reports as DRAFTS, one per business and service,
# from real records only (site checks, enquiries, deliveries, the figures staff entered). It sends nothing and emails nobody: staff
# review each draft in the console (Reports) and send it from there. A report staff already approved or sent is left alone, and a
# service with nothing measured gets no report. Installed by deploy/vps/install.sh but NOT enabled: enabling it is the owner's
# call (docs/monthly-reports.md). It reads the dashboard's environment through the release's apps/platform/.env.local link, as the
# site health job does, so it needs a deployed release. It writes only to the database. pnpm needs a writable home for its own
# cache, so HOME is the unit's cache directory. Preview by hand (writes nothing):
#   cd /srv/brandbasket/current-platform && runuser -u brandbasket -- pnpm reports:run -- --dry-run
[Unit]
Description=Brandbasket monthly customer reports (drafts for staff review)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
WorkingDirectory=/srv/brandbasket/current-platform
CacheDirectory=brandbasket-monthly-reports
Environment=HOME=/var/cache/brandbasket-monthly-reports
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ExecStart=/usr/bin/env pnpm reports:run
Nice=10
IOWeight=20
TimeoutStartSec=30min
MemoryMax=400M
LimitNOFILE=65535
SyslogIdentifier=brandbasket-monthly-reports
# Sandbox (Firstfold's app hardening): read-only system, no writable paths, no privileges, no unneeded syscalls. Firstfold's
# folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores a path that is not
# there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
