# Starts brandbasket-google-provision.service every 15 minutes. A run still going when the next is due is not started twice
# (a oneshot unit that is active is left alone). Installed, not enabled (docs/deployment/brandbasket-vps.md, "Google").
[Unit]
Description=Brandbasket Google go live every 15 minutes

[Timer]
OnCalendar=*:0/15
Persistent=false
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
