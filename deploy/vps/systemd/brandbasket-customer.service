# Runs the Brandbasket customer app v4 (apps/customer) on port 3202, behind nginx, as the brandbasket user. Installed to
# /etc/systemd/system/ by deploy/vps/install.sh services, but NOT enabled there: it has nothing to run until the owner turns
# the customer app on (docs/deployment/brandbasket-vps.md, "Customer app v4"), and an enabled unit with no release would fail
# at every boot and send an alert. /srv/brandbasket/current-customer is a symlink to the live release (brandbasket-platform-release
# moves it and restarts this unit); the release's apps/customer/.env.production is a link to
# /srv/brandbasket/shared/customer.env.production, which `next start` reads itself. It writes only the releases folder (Next's
# .next/cache), the uploaded media and the private support files, the same folders as the admin console (the apps share uploads).
[Unit]
Description=Brandbasket customer app v4 (apps/customer)
After=network-online.target postgresql.service
Wants=network-online.target
# Three failed starts in a minute is a broken release, not a blip: stop and let the release script (or a person) decide.
# (These two belong in [Unit]; in [Service] systemd ignores them.)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=brandbasket
Group=brandbasket
WorkingDirectory=/srv/brandbasket/current-customer/apps/customer
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# The V8 heap stays below the cgroup limits so the process is asked to collect garbage before systemd has to act.
Environment=NODE_OPTIONS=--max-old-space-size=512
# No -H flag, on purpose (see brandbasket-admin.service): port 3202 must stay closed to the outside through ufw.
ExecStart=/srv/brandbasket/current-customer/apps/customer/node_modules/.bin/next start -p 3202
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
# Next exits 143 on SIGTERM: a normal stop (every deploy restarts the unit), not a failure that sends an alert.
SuccessExitStatus=143
LimitNOFILE=65535
# Low ceiling so a leak cannot take the database and nginx down with it: MemoryHigh slows the process first, MemoryMax is
# the hard stop (the service is then restarted by Restart=on-failure). Killed before Postgres if memory runs out.
# Starting values, below the platform app's 800M/1000M: measure the VPS and this process on next.brandbasket.in, then adjust
# (the plan asks for the memory check before the process is added).
MemoryHigh=650M
MemoryMax=800M
OOMScoreAdjust=300
TasksMax=256
SyslogIdentifier=brandbasket-customer
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK: Next lists network interfaces at startup (os.networkInterfaces), which needs a netlink socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/srv/brandbasket/releases /srv/brandbasket/media /srv/brandbasket/support-private
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci

[Install]
WantedBy=multi-user.target
