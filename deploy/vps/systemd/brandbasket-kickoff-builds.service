# Starts the website build for every customer whose kickoff call is over: POSTs to the dashboard's own
# /api/internal/start-builds-after-kickoff on 127.0.0.1 with the bearer token from the environment file, and prints the report
# (docs/kickoff-builds.md). It moves a website project from onboarding to submitted, with the first preview due 48 hours after
# the call, and adds one "What we did" line for the customer. Safe to run as often as wanted: a project that has already moved
# is not touched. Enabled with the maintenance timer once the first deploy exists. KICKOFF_SYNC_TOKEN is in
# /srv/brandbasket/shared/platform.env.local (make-env-files.sh generates it; add it by hand to a file made earlier).
# brandbasket-kickoff-builds-job keeps the token out of the process list. It writes nothing itself (the app does the work), so
# this unit has no writable paths. By hand:
#   runuser -u brandbasket -- /usr/local/sbin/brandbasket-kickoff-builds-job --env-file /srv/brandbasket/shared/platform.env.local
[Unit]
Description=Brandbasket start website builds after kickoff calls
After=brandbasket-app.service

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
ExecStart=/usr/local/sbin/brandbasket-kickoff-builds-job --env-file /srv/brandbasket/shared/platform.env.local
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-kickoff-builds
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
