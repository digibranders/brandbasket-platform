# The nightly roll-up of the first-party site analytics (docs/site-analytics.md): POSTs to the dashboard's own
# /api/internal/roll-up-site-analytics on 127.0.0.1 with the bearer token from the environment file. It turns the day's site
# hits into numbers and deletes hits older than 90 days. Enabled with the maintenance timer once the first deploy exists.
# SITE_ANALYTICS_TOKEN is in /srv/brandbasket/shared/platform.env.local (make-env-files.sh generates it; add it by hand to a
# file made earlier). brandbasket-site-rollup-job keeps the token out of the process list. It writes nothing itself (the app
# does the work), so this unit has no writable paths. Dry run by hand:
#   runuser -u brandbasket -- /usr/local/sbin/brandbasket-site-rollup-job --env-file /srv/brandbasket/shared/platform.env.local --dry-run
[Unit]
Description=Brandbasket nightly site analytics roll-up
After=brandbasket-app.service

[Service]
Type=oneshot
User=brandbasket
Group=brandbasket
ExecStart=/usr/local/sbin/brandbasket-site-rollup-job --env-file /srv/brandbasket/shared/platform.env.local
TimeoutStartSec=10min
SyslogIdentifier=brandbasket-site-rollup
# Sandbox (Firstfold's app hardening): read-only system, writable only where this unit writes, no privileges, no unneeded
# syscalls. Firstfold's folders, its env files, keys and backups do not exist for this unit (InaccessiblePaths; the "-" ignores
# a path that is not there).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=-/srv/firstfold -/srv/firstfold-website -/srv/firstfold-media -/srv/firstfold-ci -/etc/firstfold -/var/backups -/var/lib/firstfold -/var/lib/firstfold-ci
