# The public endpoints that have no screen, sent to apps/customer (port 3202), which now holds every one of them: client websites,
# payment providers, timer jobs, the marketing site and the blog images. Replaces brandbasket-split-platform-paths.conf.example, which
# sent the same paths to apps/platform (brandbasket_app, 3201). NOT APPLIED by install.sh. Install by hand as
# /etc/nginx/snippets/brandbasket-public-paths.conf and point the server block's include at it (runbook, "Switching the platform
# paths to apps/customer"). The old snippet is left in place until the switch has held for a few days; it is the rollback.
#
#   /api/site/                 client websites (site token): info, events, posts, media
#   /api/t, /t/                the site analytics hit and the tracking script (public/t/v1.js)
#   /api/leads, /api/pricing   the marketing website
#   /api/webhooks/             Razorpay, Cal.com and OyeChats
#   /api/internal/             timer jobs: erase accounts, kickoff builds, hosting sync, analytics roll-up, conversions
#   /api/privacy-requests/     the public privacy request form
#   /api/content-media-uploads, /content-media/   blog images
#
# These now go to the same upstream as `location /`, so the block adds nothing except the fixed Host header and the separate
# regex location. It exists so the move is one include line, and so each path can be moved back on its own. Once the switch is
# done and apps/platform is gone, delete this file and its include: `location /` covers every path.
#
# Host is sent as app.brandbasket.in on purpose, so a request that reached nginx under another name (next.brandbasket.in) still
# looks like the production host to the app. The other proxy settings are those of snippets/brandbasket-proxy.conf (keep them in
# step with it; only Host differs).
#
# A regex location, so it is placed BEFORE the other regex locations in the server block that includes it: nginx takes the first
# regex that matches.
location ~ ^/(api/(site|t|leads|pricing|webhooks|internal|privacy-requests|content-media-uploads)(/|$)|t/|content-media/) {
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host app.brandbasket.in;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
    proxy_buffer_size 16k;
    proxy_buffers 4 16k;
    proxy_busy_buffers_size 32k;
    proxy_pass http://brandbasket_customer;
}
