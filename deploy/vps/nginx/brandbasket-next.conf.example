# Staging for the customer app v4: https://next.brandbasket.in, behind Cloudflare Access, on production data with a test account.
# NOT APPLIED. Install by hand when the owner starts staging:
#
#   cp this file to /etc/nginx/sites-available/brandbasket-next, link it into sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# Nothing here touches app.brandbasket.in or console.brandbasket.in. It relies on what sites-brandbasket already defines for the
# whole http context: the rate-limit zones brandbasket_general, brandbasket_signin and brandbasket_perip, the map
# $brandbasket_limit_key and the upstream brandbasket_customer (3202).
#
# Certificate: its own lineage, so the existing "brandbasket" lineage (app and console) is never reissued with a different name list.
#   certbot certonly --webroot -w /var/www/acme --cert-name brandbasket-next --key-type ecdsa -d next.brandbasket.in
# The shared certbot.timer renews it and Firstfold's hook reloads nginx. HTTP-01 goes through Cloudflare: the Access application
# must let /.well-known/acme-challenge/* through (a bypass policy on that path), or issue the certificate before Access goes on.
#
# DNS: an AAAA record for next, proxied, same address as app (IPv6 only). Cloudflare Access protects the name; this file also refuses
# anything that did not come through Cloudflare, as the console does, so the origin address cannot be used to skip Access.

server {
    listen 80;
    listen [::]:80;
    server_name next.brandbasket.in;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name next.brandbasket.in;

    ssl_certificate     /etc/letsencrypt/live/brandbasket-next/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brandbasket-next/privkey.pem;
    ssl_session_cache   shared:brandbasket_ssl:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    include snippets/cloudflare-realip.conf;

    # Staging stays behind Cloudflare (and Access) while the origin address is public: refuse anything that did not come through
    # Cloudflare. Loopback stays allowed for checks on this box.
    set $next_denied 1;
    if ($from_cloudflare) { set $next_denied 0; }
    if ($realip_remote_addr = "127.0.0.1") { set $next_denied 0; }
    if ($next_denied) { return 403; }

    client_max_body_size 25m;
    limit_req  zone=brandbasket_general burst=100 nodelay;
    limit_conn brandbasket_perip 50;

    location ~ /\.(?!well-known) { return 404; }

    # Brute-force guard in front of the app's own database-backed sign-in limits (same paths as app.brandbasket.in).
    location ~ ^/(login|join|forgot-password|reset-password|restore-account)(/|$) {
        limit_req zone=brandbasket_signin burst=20 nodelay;
        include snippets/brandbasket-proxy.conf;
        proxy_pass http://brandbasket_customer;
    }

    # Everything else is the new app.
    location / {
        include snippets/brandbasket-proxy.conf;
        proxy_pass http://brandbasket_customer;
    }
}
