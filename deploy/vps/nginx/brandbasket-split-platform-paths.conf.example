# The public endpoints that stay in apps/platform while apps/customer serves the dashboard (plan 61, assumption A3). Included by
# both brandbasket-next.conf.example (next.brandbasket.in) and brandbasket-cutover.conf.example (app.brandbasket.in), so the list
# exists once. NOT APPLIED by install.sh. Install by hand as /etc/nginx/snippets/brandbasket-split-platform-paths.conf.
#
# Every one of these has no screen: client websites, payment providers, jobs and the marketing site call them.
#   /api/site/                 client websites (site token): info, events, posts, media
#   /api/t, /t/                the site analytics hit and the tracking script (public/t/v1.js)
#   /api/leads, /api/pricing   the marketing website
#   /api/webhooks/             Razorpay, Cal.com and OyeChats
#   /api/internal/             timer jobs: erase accounts, kickoff builds, hosting sync, analytics roll-up, conversions
#   /api/privacy-requests/     the public privacy request form
#   /api/content-media-uploads, /content-media/   blog images (apps/platform stores and serves them)
# Everything else under /api/ (uploads, brand-assets, support-uploads, error-reports) has a twin in apps/customer and goes there.
#
# Host is sent as app.brandbasket.in on purpose. apps/platform's proxy.ts answers 404 for any host that is not its own APP_ORIGIN,
# and /content-media/ is a page route behind that check, so passing next.brandbasket.in through would break it. The /api routes
# skip the check, so they work either way. The other proxy settings are those of snippets/brandbasket-proxy.conf (keep them
# in step with it; only Host differs).
#
# A regex location, so it is placed BEFORE the other regex locations in the server block that includes it: nginx takes the first
# regex that matches.
location ~ ^/(api/(site|t|leads|pricing|webhooks|internal|privacy-requests|content-media-uploads)(/|$)|t/|content-media/) {
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host app.brandbasket.in;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
    proxy_buffer_size 16k;
    proxy_buffers 4 16k;
    proxy_busy_buffers_size 32k;
    proxy_pass http://brandbasket_app;
}
