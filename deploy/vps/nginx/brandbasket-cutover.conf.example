# The cutover: app.brandbasket.in served by the customer app v4. NOT APPLIED. This is the `server { listen 443 ... server_name
# app.brandbasket.in; }` block of /etc/nginx/sites-available/brandbasket (deploy/vps/nginx/sites-brandbasket) with two changes:
# the upstream behind `location /` and the sign-in paths, and the public endpoints split off to platform. Nothing else differs,
# so the same host and the same cookie keep every customer signed in, as long as APP_ORIGIN and BETTER_AUTH_SECRET in
# customer.env.production equal platform's (runbook, "Customer app v4").
#
# To cut over, replace that one server block in sites-brandbasket with the block below, `nginx -t`, `systemctl reload nginx`.
# Needs the upstream brandbasket_customer from brandbasket-next.conf.example (install that first and keep it) and
# snippets/brandbasket-split-platform-paths.conf.
#
# ROLLBACK, one change: in both `proxy_pass` lines marked below, put brandbasket_app back (the commented line beside each is the
# old one), `nginx -t`, reload. Or restore the unmodified server block from deploy/vps/nginx/sites-brandbasket. Platform keeps
# running the whole time, so nothing else has to move. Data written by either app is readable by both (additive migrations only).

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.brandbasket.in;

    ssl_certificate     /etc/letsencrypt/live/brandbasket/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brandbasket/privkey.pem;
    ssl_session_cache   shared:brandbasket_ssl:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # A validator that was redirected to https lands here too.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    # Visitor address: from CF-Connecting-IP only when the peer is a Cloudflare address (proxied), otherwise the peer itself.
    include snippets/cloudflare-realip.conf;

    # Uploads (support screenshots, product photos). The app enforces its own, smaller limits per route.
    client_max_body_size 25m;
    limit_req  zone=brandbasket_general burst=100 nodelay;
    limit_conn brandbasket_perip 50;

    location ~ /\.(?!well-known) { return 404; }

    # Public endpoints stay on platform: webhooks, client sites, jobs, the marketing site (first regex location).
    include snippets/brandbasket-split-platform-paths.conf;

    # Brute-force guard in front of the app's own database-backed sign-in limits.
    location ~ ^/(login|join|forgot-password|reset-password|restore-account)(/|$) {
        limit_req zone=brandbasket_signin burst=20 nodelay;
        include snippets/brandbasket-proxy.conf;
        proxy_pass http://brandbasket_customer;   # ROLLBACK: http://brandbasket_app
        # proxy_pass http://brandbasket_app;
    }

    location / {
        include snippets/brandbasket-proxy.conf;
        proxy_pass http://brandbasket_customer;   # ROLLBACK: http://brandbasket_app
        # proxy_pass http://brandbasket_app;
    }
}
