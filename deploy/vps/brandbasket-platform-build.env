# Build-time environment for the two platform apps (platform, admin), read by brandbasket-platform-release and by the CI
# sandbox (ci-steps.sh). Installed as /etc/brandbasket-platform-build.env (root:root 0644), so it must hold nothing secret:
# the first four values are public (addresses and the Tag Manager container id) compiled into the browser bundle, and the rest are placeholders that only
# satisfy the env schemas. Port 9 has no listener, so a build that tried to open a database connection would fail
# rather than reach a real database. The real settings are in /srv/brandbasket/shared/*.env.local, linked into a release
# only after its build.
APP_ORIGIN=https://app.brandbasket.in
ADMIN_ORIGIN=https://console.brandbasket.in
NEXT_PUBLIC_APP_URL=https://app.brandbasket.in
NEXT_PUBLIC_GTM_ID=GTM-57VWMSJ8
DATABASE_URL=postgresql://build:build@127.0.0.1:9/build
DATABASE_URL_STAFF=postgresql://build:build@127.0.0.1:9/build
DATABASE_URL_PUBLIC=postgresql://build:build@127.0.0.1:9/build
DATABASE_URL_PAYLOAD=postgresql://build:build@127.0.0.1:9/build
PAYLOAD_SECRET=build-placeholder-not-a-real-secret-0000
BETTER_AUTH_SECRET=build-placeholder-not-a-real-secret-0000
