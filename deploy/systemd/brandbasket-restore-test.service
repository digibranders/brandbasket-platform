# What this does: restores the newest database backup into a throwaway database, checks it, and drops it again. If this
# fails the backups cannot be trusted: check `systemctl status brandbasket-restore-test` after the first Sunday of the timer.
# Installed by bootstrap-droplet.sh; started by brandbasket-restore-test.timer. Runs as root (it uses the postgres user).
[Unit]
Description=Brandbasket weekly backup restore test
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/brandbasket-restore-test --apply
TimeoutStartSec=1h
Nice=10
SyslogIdentifier=brandbasket-restore-test
