# What this does: the daily erase of accounts whose owners asked to delete them 30 days ago (docs/account-erasure.md):
# POSTs to the dashboard's own /api/internal/erase-closed-accounts on 127.0.0.1 with the bearer token from the environment file.
# Installed by bootstrap-droplet.sh; started by fynix-erase.timer. Assumes ACCOUNT_ERASE_TOKEN is set in
# /srv/fynix/shared/platform.env.local (make-env-files.sh generates it). scripts/server/run-erase-job.sh keeps the token out of
# the process list. Dry run by hand: sudo -u deploy /usr/local/sbin/fynix-erase-job --env-file /srv/fynix/shared/platform.env.local --dry-run
[Unit]
Description=Fynix daily erase of closed accounts
After=fynix-app.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/sbin/fynix-erase-job --env-file /srv/fynix/shared/platform.env.local
TimeoutStartSec=10min
SyslogIdentifier=fynix-erase
NoNewPrivileges=true
PrivateTmp=true
