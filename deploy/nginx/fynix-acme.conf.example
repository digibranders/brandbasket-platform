# What this does: the port-80 half for Fynix's two hostnames: answers Let's Encrypt's HTTP challenge from /var/www/certbot and
# sends every other plain-http request to https. Install this FIRST (before the https files exist, so `nginx -t` passes), issue
# the certificate, then install fynix-app.conf and fynix-admin.conf. Safe to leave in place afterwards.
# Assumes: nginx already runs on this droplet (it fronts the Pavel API); nothing else answers these two server_names;
# `app.fynix.digital` / `console.fynix.digital` are replaced by bootstrap-droplet.sh with the real names (--app-host / --admin-host).
# Install: /etc/nginx/sites-available/fynix-acme.conf, linked from sites-enabled (bootstrap-droplet.sh does both, then `nginx -t`).
# Check it: `sudo nginx -t` is the real test; it cannot be run off the server (see docs/deployment/fynix-droplet.md, section 6).
server {
    listen 80;
    listen [::]:80;
    server_name app.fynix.digital console.fynix.digital;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
