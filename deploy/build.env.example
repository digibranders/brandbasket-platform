# The only settings a production BUILD needs that are not placeholders: the public addresses, compiled into the browser code.
# Copy to deploy/build.env (git-ignored) on the machine that runs scripts/server/deploy.sh. No secrets belong here: the build
# runs with placeholder database URLs and secrets, and the real ones are only on the server (/srv/fynix/shared/*.env.local).
APP_ORIGIN=https://app.fynix.digital
ADMIN_ORIGIN=https://console.fynix.digital
NEXT_PUBLIC_APP_URL=https://app.fynix.digital
# Optional, public: the marketing site and contact details shown in links (defaults are https://fynix.digital and hello@fynix.digital).
# NEXT_PUBLIC_SITE_URL=https://fynix.digital
# NEXT_PUBLIC_CONTACT_EMAIL=hello@fynix.digital
# Optional: a release label shown on error reports, and the error-reporting address if you use Sentry.
# NEXT_PUBLIC_FYNIX_RELEASE=
# NEXT_PUBLIC_SENTRY_DSN=
